{
  "name": "alberta-insurance-rules-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build && node --watch apps/api/dist/server.js",
    "dev:web": "npm run dev -w @alberta-rules/web",
    "start": "node apps/api/dist/server.js",
    "build": "npm run build -w @alberta-rules/core && npm run build -w @alberta-rules/web && npm run build -w @alberta-rules/api && tsc -p tsconfig.scripts.json",
    "typecheck": "tsc --noEmit && npm run typecheck -w @alberta-rules/web",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run apps/api/test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist-scripts/scripts/migrate.js",
    "bootstrap:admin": "node dist-scripts/scripts/bootstrap-admin.js",
    "plans:import": "node dist-scripts/scripts/import-plans.js",
    "benchmark": "node dist-scripts/scripts/benchmark.js"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.7.2",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.5",
    "fast-check": "^4.3.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
