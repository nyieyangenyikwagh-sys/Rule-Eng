# PostgreSQL (required by Docker Compose)
POSTGRES_USER=alberta_rules
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=alberta_rules
POSTGRES_PORT=5432

# Initial PostgreSQL-backed administrator (required on first startup)
BOOTSTRAP_ADMIN_EMAIL=administrator@your-organization.ca
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Application
APP_PORT=8000
SESSION_TTL_MINUTES=480
RATE_LIMIT_MAX=120

# Direct Node execution outside Docker uses this connection string.
DATABASE_URL=postgres://alberta_rules:replace-with-a-long-random-database-password@localhost:5432/alberta_rules
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=production
